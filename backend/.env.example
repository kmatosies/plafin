# ==============================================
# Service OS — Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env e preencha os valores

# --- Supabase ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
# Aliases temporarios aceitos: SUPABASE_KEY e SUPABASE_SERVICE_KEY

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXX

# Plano STARTER (mensal)
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_XXX

# Plano PRO (mensal)
STRIPE_PRICE_PRO_MONTHLY_BRL=price_pro_monthly_brl_XXX
STRIPE_PRICE_PRO_MONTHLY_USD=price_pro_monthly_usd_XXX
# Alias temporario aceito para BRL: STRIPE_PRICE_PRO_MONTHLY

# --- Google Gemini ---
GEMINI_API_KEY=sua-chave-gemini-aqui

# --- Email para notificacoes ---
# Reservado; o worker atual envia por SMTP.
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=no-reply@serviceos.app

# --- WhatsApp (Evolution API) — Plano PRO ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-evolution-aqui
EVOLUTION_INSTANCE=sua-instancia

# --- App ---
APP_NAME=Service OS
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_URL=http://localhost:8000
ENABLE_NOTIFICATION_WORKER=false

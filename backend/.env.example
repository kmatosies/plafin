# Plafin backend environment template. Never commit real values.

# Application
APP_NAME=Plafin
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_URL=http://localhost:8000
BUSINESS_TIMEZONE=America/Sao_Paulo

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Temporary aliases: SUPABASE_KEY and SUPABASE_SERVICE_KEY

# Stripe test mode, BRL only
STRIPE_SECRET_KEY=<stripe-test-secret-or-restricted-key>
STRIPE_WEBHOOK_SECRET=<stripe-test-webhook-secret>
STRIPE_PRICE_PRO_MONTHLY_BRL=<stripe-pro-monthly-brl-price-id>
# Temporary alias: STRIPE_PRICE_PRO_MONTHLY

# Local one-off admin scripts only. Do not configure these on Render.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# Notification worker remains disabled in the API service
ENABLE_NOTIFICATION_WORKER=false
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
NOTIFICATION_WORKER_ERROR_BACKOFF_SECONDS=300

# Optional SMTP settings for the future worker service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@plafin.online

# Phase 2 integrations, intentionally disabled when empty
GEMINI_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
